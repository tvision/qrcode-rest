{
    "name": "terravision/rest-qr-code",
    "description": "Thin REST QR-code image generator for Terravision ticket URLs",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "endroid/qr-code": "^6.1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Terravision\\QRCode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Terravision\\QRCode\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
